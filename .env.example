# 服务监听端口
PORT=3000
# MySQL 连接串（Prisma 也读这个变量）
DATABASE_URL="mysql://root:password@localhost:3306/mentor-back"
# Redis 连接串
REDIS_URL="redis://localhost:6379/0"
# JWT 签名密钥。**必填**，长度不得少于 32 个字符。
# 留空会在启动时被环境校验拦下——这是故意的：空密钥跑起来比跑不起来危险得多。
# 生成一个：openssl rand -base64 48
JWT_SECRET=

# ── 统一认证（SSO）────────────────────────────────────────────────
# mock  = 本地联调：回调里的 ticket 直接当作工号。NODE_ENV=production 下不可用
# oidc  = 通用 OIDC 授权码模式；学校 / 企业文档到位后按需改 employeeNoClaim
SSO_PROVIDER=mock
# 以下仅 SSO_PROVIDER=oidc 时必填
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
# userinfo 响应里存放工号的字段名
SSO_EMPLOYEE_NO_CLAIM=employeeNo
# 认证 state 的存活时间（秒）
SSO_STATE_TTL_SECONDS=300

# ── 统一认证登录（后端代理 api-login）─────────────────────────────
# 打开后 POST /auth/login 先调 SSO；只有网络不可达才回退本地密码。
SSO_LOGIN_ENABLED=0
SSO_BASE_URL=
SSO_APP_ID=
SSO_APP_SECRET=
# rsa = 用 /sso/app/public-key 加密 clientSecret（推荐）；plain = 明文 appKey
SSO_APP_SECRET_MODE=rsa
SSO_API_LOGIN_PATH=/sso/login/api-login
SSO_PUBLIC_KEY_PATH=/sso/app/public-key
SSO_API_LOGIN_TIMEOUT_MS=5000
# 本地令牌桶，默认 55 次/分钟（低于 SSO 单应用 60 次/分钟）
SSO_RATE_LIMIT_PER_MINUTE=55
# 只有网络不可达才回退；HTTP 5xx 默认不回退
SSO_FALLBACK_ENABLED=1
SSO_FALLBACK_ON_5XX=0
# 校内私有 CA 的 PEM 路径；留空 = 用系统信任链（生产不允许关闭校验）
SSO_CA_CERT_PATH=

# ── 统一认证数据同步（开放接口）───────────────────────────────────
SSO_SYNC_ENABLED=0
# 直连后端用 /api；经 Nginx 剥前缀时留空
SSO_OPENAPI_PREFIX=/api
SSO_SYNC_INTERVAL_SECONDS=21600
SSO_SYNC_FULL_INTERVAL_SECONDS=604800
SSO_SYNC_PAGE_SIZE=200
# 登录自动建号时，学生部门映射失败的兜底部门 code；留空用根部门
SSO_SYNC_DEFAULT_DEPT_CODE=

# ── CORS ─────────────────────────────────────────────────────────
# 允许跨域的来源白名单，逗号分隔。必须是「协议 + 主机 + 端口」，不含路径。
# 空 = 拒绝一切跨域（生产环境为空会启动失败）。
CORS_ORIGINS=http://localhost:5173

# ── 在线文档 ─────────────────────────────────────────────────────
# /api-docs 是否挂载。不配时按环境走：NODE_ENV=production 关、其余开。
# 它不登录就能打开，等于把整套接口面公开，所以生产默认关。
# 内网要留一份时显式写 1。
# SWAGGER_ENABLED=

# ── 业务时区 ─────────────────────────────────────────────────────
# 导师开的时段（weekday + HH:mm）是「每周重复的墙钟时间」，本身不带时区；
# 预约的 requestedTime 是 UTC 时刻。比对前把后者转成本时区（R31）。
# 必须是合法的 IANA 时区名，拼错会让进程起不来。
# APP_TIMEZONE=Asia/Shanghai

# ── 预约超时扫描 ─────────────────────────────────────────────────
# 两条规则，都是 SysConfig 的键（不是环境变量），改值走后台配置：
#   1. `0 PENDING` 超过 `appointment.pending_ttl_hours`（默认 72 小时）→ `9 EXPIRED`
#   2. `1 CONFIRMED` 且 `requestedTime` 早于「现在 − `appointment.confirmed_grace_hours`」
#      （默认 24 小时）→ `9 EXPIRED`（R38：已确认但没发生的预约不该永远停在 1）
# 负值一律按 0 处理。不配时按环境走：NODE_ENV=test 关、其余开。
# 间隔单位是秒，默认 300。
# APPOINTMENT_EXPIRY_SCAN_ENABLED=
# APPOINTMENT_EXPIRY_SCAN_INTERVAL_SECONDS=300

# ── 种子初始值（prisma/seed.ts 读）───────────────────────────────
# 根组织名。种子不替你决定行业用词：学校填「学院」口径，企业填「公司」口径
SEED_ROOT_DEPT_NAME=总部
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_REAL_NAME=超级管理员
# 不填则随机生成，密码只打印一次
# SEED_ADMIN_PASSWORD=

# ── 本地文件存储（src/modules/file/ 的 /files）──────────────────
# 上传文件落盘的根目录。相对路径按进程工作目录解析
FILE_ROOT=.uploads
# 单文件大小上限（字节）。默认 10 MB
FILE_MAX_BYTES=10485760

# ── 限流 ─────────────────────────────────────────────────────────
# 全站默认限流：每个「身份 × 接口」在窗口内的请求数上限 / 窗口秒数。
# 身份优先取登录用户（u:<userId>），未登录才退回 IP（ip:<addr>）——
# 高校出口 NAT 后面几千个真实用户共用一个 IP，按 IP 卡会误伤一整栋楼。
# 种子给的是保守默认值，生产请按真实流量调小。
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
