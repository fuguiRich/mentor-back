# 服务监听端口
PORT=3000
# MySQL 连接串（Prisma 也读这个变量）
DATABASE_URL="mysql://root:password@localhost:3306/mentor-back"
# Redis 连接串
REDIS_URL="redis://localhost:6379/0"
# JWT 签名密钥。**必填**，长度不得少于 32 个字符。
# 留空会在启动时被环境校验拦下——这是故意的：空密钥跑起来比跑不起来危险得多。
# 生成一个：openssl rand -base64 48
JWT_SECRET=

# ── 统一认证（SSO）────────────────────────────────────────────────
# mock  = 本地联调：回调里的 ticket 直接当作工号。NODE_ENV=production 下不可用
# oidc  = 通用 OIDC 授权码模式；学校 / 企业文档到位后按需改 employeeNoClaim
SSO_PROVIDER=mock
# 以下仅 SSO_PROVIDER=oidc 时必填
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
# userinfo 响应里存放工号的字段名
SSO_EMPLOYEE_NO_CLAIM=employeeNo
# 认证 state 的存活时间（秒）
SSO_STATE_TTL_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────
# 允许跨域的来源白名单，逗号分隔。必须是「协议 + 主机 + 端口」，不含路径。
# 空 = 拒绝一切跨域（生产环境为空会启动失败）。
CORS_ORIGINS=http://localhost:5173

# ── 在线文档 ─────────────────────────────────────────────────────
# /api-docs 是否挂载。不配时按环境走：NODE_ENV=production 关、其余开。
# 它不登录就能打开，等于把整套接口面公开，所以生产默认关。
# 内网要留一份时显式写 1。
# SWAGGER_ENABLED=

# ── 种子初始值（prisma/seed.ts 读）───────────────────────────────
# 根组织名。种子不替你决定行业用词：学校填「学院」口径，企业填「公司」口径
SEED_ROOT_DEPT_NAME=总部
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_REAL_NAME=超级管理员
# 不填则随机生成，密码只打印一次
# SEED_ADMIN_PASSWORD=

# ── 本地文件存储（src/modules/file/ 的 /files）──────────────────
# 上传文件落盘的根目录。相对路径按进程工作目录解析
FILE_ROOT=.uploads
# 单文件大小上限（字节）。默认 10 MB
FILE_MAX_BYTES=10485760

# ── 限流 ─────────────────────────────────────────────────────────
# 全站默认限流：每个「身份 × 接口」在窗口内的请求数上限 / 窗口秒数。
# 身份优先取登录用户（u:<userId>），未登录才退回 IP（ip:<addr>）——
# 高校出口 NAT 后面几千个真实用户共用一个 IP，按 IP 卡会误伤一整栋楼。
# 种子给的是保守默认值，生产请按真实流量调小。
RATE_LIMIT_DEFAULT_LIMIT=300
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
