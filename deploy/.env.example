# Docker 部署配置：复制为 deploy/.env，按服务器实际值修改，权限 600。
# 这个文件同时用于：
#   1. compose 的变量替换（MYSQL_* / 端口）；
#   2. 后端容器的 env_file（JWT / SSO / CORS 等）。
# 不入库（.gitignore 已忽略 deploy/.env）。
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   openssl rand -base64 48           # 生成 JWT_SECRET

# ── 基础 ──────────────────────────────────────────────────────────
TZ=Asia/Shanghai

# ── MySQL（compose 内建）──────────────────────────────────────────
# 密码请用 URL 安全字符（不要 @ : / ? # %），否则 DATABASE_URL 需要转义
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=mentor_back
MYSQL_USER=mentor
MYSQL_PASSWORD=change-me-mentor

# ── 端口（默认只绑 127.0.0.1，由宿主机 nginx 反代）──────────────────
BACKEND_PORT=3000
WEB_PORT=8081
MOBILE_PORT=8082
# 直接用 IP:端口访问时改成 0.0.0.0（one-click 脚本会自动按访问方式设置）
BIND_ADDR=127.0.0.1

# ── 宿主机 nginx ───────────────────────────────────────────────────
# 服务器已有其他站点：只写 mentor-web.conf / mentor-mobile.conf，
# 写前检查 server_name 冲突，写后 nginx -t 失败自动回滚，不碰别人的配置。
# 1 = 按域名自动生成站点；0 = 只跳过（容器端口仍监听 BIND_ADDR）
NGINX_CONFIGURE=1
NGINX_CONF_DIR=/etc/nginx/conf.d
WEB_DOMAIN=
MOBILE_DOMAIN=

# ── 后端应用配置 ───────────────────────────────────────────────────
# DATABASE_URL / REDIS_URL / FILE_ROOT / PORT 由 docker-compose.yml 注入，
# 这里不用写。
JWT_SECRET=please-change-to-a-random-48-byte-string

# 文件上传（FILE_ROOT=/data/uploads 在 compose 里固定，落在 uploads 命名卷）
FILE_MAX_BYTES=10485760

# 生产默认不挂 Swagger
SWAGGER_ENABLED=0

# 前端与后端同源（nginx 反代 /api），通常留空即可；
# 只有别的来源直连后端时才需要列白名单
CORS_ORIGINS=

# SSO：按学校实际值填写；不用统一认证时保持 0
SSO_LOGIN_ENABLED=0
SSO_PROVIDER=oidc
SSO_BASE_URL=
SSO_APP_ID=
SSO_APP_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://admin.example.com/api/auth/sso/callback

# 统一认证定时同步（按需）
SSO_SYNC_ENABLED=0
SSO_SYNC_STUDENTS_ENABLED=1

# 首次 seed 可显式指定超管密码；不写则随机生成、只打印一次
# SEED_ADMIN_PASSWORD=change-me-admin

# 绝对不要在服务器上打开演示数据：演示账号是公开密码
# SEED_DEMO_DATA=1