# 从本地发布到远端 Linux 服务器：复制为 deploy-remote.env 后修改。
# deploy-remote.env 不入库（.gitignore 已忽略）；权限建议 600。
#
# 前置：本机能免密 ssh 到服务器
#   ssh-keygen -t ed25519        # 已有密钥可跳过
#   ssh-copy-id -p 22 mentor@<server-ip>
#   ssh -p 22 mentor@<server-ip> 'echo ok'
#
# 用法：
#   bash scripts/deploy/deploy-remote.sh all
#   bash scripts/deploy/deploy-remote.sh backend
#   bash scripts/deploy/deploy-remote.sh web mobile
#   bash scripts/deploy/deploy-remote.sh all --seed      # 首次部署
#   bash scripts/deploy/deploy-remote.sh all --check     # 远端只做检查

REMOTE_HOST=your.server.ip
REMOTE_USER=mentor
REMOTE_PORT=22
SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=10"

# 服务器上的目录（与部署手册一致）
REMOTE_APP_ROOT=/opt/mentor
REMOTE_BACKEND_DIR=/opt/mentor/mentor-back
REMOTE_WEB_SRC=/opt/mentor/mentor-web
REMOTE_MOBILE_SRC=/opt/mentor/mentor-mobile

# 本地源码目录（默认本仓库 + 同级两个前端；不在同级时改这里）
# LOCAL_BACKEND_DIR=/path/to/mentor-back
# LOCAL_WEB_DIR=/path/to/mentor-web
# LOCAL_MOBILE_DIR=/path/to/mentor-mobile

# 远端运行方式：
#   native  systemd 跑后端 + nginx 直接托管静态目录（scripts/deploy/deploy.sh）
#   docker  docker compose 跑 mysql/redis/后端/两个前端（scripts/deploy/deploy-docker.sh）
#           Docker 构建发生在远端 Linux 服务器上，本地不需要 Docker
DEPLOY_MODE=native

# 后端源码同步方式：
#   git  远端 git pull（默认；要求当前分支已 push，.env 不会被碰）
#   tar  上传本地工作区（含未提交改动；保留远端 .env / .uploads / deploy.env）
BACKEND_SYNC=git
# 使用 git 方式时要部署的分支；不填则用本地当前分支
# GIT_BRANCH=main

# 远端 deploy.sh 读的配置（服务器上那份）
REMOTE_DEPLOY_CONFIG=/opt/mentor/mentor-back/scripts/deploy/deploy.env

# 只用于部署结束后的提示输出
PUBLIC_WEB_URL=https://admin.example.com
PUBLIC_MOBILE_URL=https://m.example.com