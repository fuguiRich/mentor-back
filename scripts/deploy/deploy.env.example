# mentor v1 部署配置：复制为 deploy.env 后按服务器实际情况修改。
# deploy.env 不入库（.gitignore 已忽略）；权限建议 600。
#
#   cp scripts/deploy/deploy.env.example scripts/deploy/deploy.env
#   chmod 600 scripts/deploy/deploy.env
#
# 也可以把配置放到任意位置，用环境变量指定：
#   DEPLOY_CONFIG=/etc/mentor/deploy.env bash scripts/deploy/deploy.sh all

# ── 源码目录 ──────────────────────────────────────────────────────
# 后端：默认就是本仓库根目录
BACKEND_DIR=/opt/mentor/mentor-back

# 前端没有 git 仓库，先把源码同步到服务器（见 docs/部署-v1.md）
WEB_SRC=/opt/mentor/mentor-web
MOBILE_SRC=/opt/mentor/mentor-mobile

# ── 发布目录（nginx root 指向 <root>/current）──────────────────────
WEB_ROOT=/var/www/mentor-web
MOBILE_ROOT=/var/www/mentor-mobile
KEEP_RELEASES=5

# 前端请求前缀；nginx 把 /api/ 反代到后端并剥掉前缀
API_BASE=/api

# ── 后端进程 ───────────────────────────────────────────────────────
# systemd：先按 scripts/deploy/mentor-back.service.example 安装 unit
# pm2：服务器上已全局安装 pm2
PROCESS_MANAGER=systemd
BACKEND_SERVICE=mentor-back
PM2_NAME=mentor-back
PM2_BIN=pm2
BACKEND_PORT=3000
HEALTH_PATH=/health

# ── nginx 站点 ───────────────────────────────────────────────
# 服务器上已有其他项目：脚本只写 mentor-web.conf / mentor-mobile.conf，
# 写前检查 server_name 冲突、写后 nginx -t 失败会回滚，不碰别人的配置。
# 1 = 按下面域名自动生成站点；0 = 只做 nginx -t + reload
NGINX_CONFIGURE=1
NGINX_CONF_DIR=/etc/nginx/conf.d
# 留空 = 不自动写站点（只做 nginx -t + reload）
WEB_DOMAIN=
MOBILE_DOMAIN=

# ── 权限与工具 ─────────────────────────────────────────────────────
# 部署用户能写发布目录时留空；写 /var/www、重启 systemd、自动安装依赖需要 sudo。
# root 直接运行会自动去掉 sudo。
# 通过 SSH 自动部署时 sudo 必须免密（NOPASSWD），否则会卡在密码提示上。
# 最小授权示例（visudo）：
#   mentor ALL=(root) NOPASSWD: /usr/bin/apt-get, /usr/bin/systemctl restart mentor-back, \
#                                 /usr/bin/systemctl is-active mentor-back, \
#                                 /usr/sbin/nginx -t, /usr/bin/systemctl reload nginx
SUDO=sudo
PNPM=pnpm

# 缺依赖时自动安装（默认 1）；0 = 只报错，不改变服务器
# AUTO_INSTALL=1

# nginx：发布静态资源后重载。不归 systemd 管可改成对应命令
RELOAD_NGINX=1
NGINX_RELOAD_CMD="sudo systemctl reload nginx"